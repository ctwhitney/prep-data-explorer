# Example environment configuration.
# Do not put production secrets in this file.

# Base path used by the deployed Data Explorer.
BASE_URL=/data-explorer/

# Production API base path.
# For production, use the HTTPS-relative Apache proxy:
VITE_API_URL=/api

# CARTO API key.
# Obtain the appropriate key through the approved credential-management process.
VITE_CARTO_API_KEY=YOUR_CARTO_API_KEY_HERE
